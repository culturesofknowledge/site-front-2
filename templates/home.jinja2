{% extends "base.jinja2" %}

{% block title %}Home{% endblock %}

{% block content %}
    {# Start EMLO intro #}
    <div class="row">

        <div class="large-2 columns"><!-- dummy column -->&nbsp;</div>

        <div class="large-10 columns" style="padding-left:25px">
            <br/>
            <h1>Welcome to Early Modern Letters Online</h1>

            <p>
                Created by the Cultures of Knowledge Project with generous funding from The Andrew W.
                Mellon Foundation, and now very generously funded by the Packard Humanities Institute,
                Early Modern Letters Online — EMLO — is a combined finding aid and editorial interface
                for basic descriptions of early modern correspondence.
            </p>
        </div>
    </div>
    {# END EMLO intro #}

    {# Start EMLO search #}
    <div id="search-form-section">
        {% include './components/home/search.jinja2' %}
    </div>
    {# End EMLO search #}

    {# START Catalogue statistics #}
    <div id="home-stats">
    </div>
    {# End Catalogue statistics #}

    {# START Featured catalogues #}
    <div id="catalogues-content">
    </div>
    {# End Featured catalogues #}

{% endblock %}


{% block extra_js_bottom %}

{% include "_edges_common_js.jinja2" %}
<script type="module" src="../static/js/home.edges.js"></script>
<script type="module" src="../static/js/tooltip.js"></script>

<script>
function changeEventOnFrom(val){
    const dat_to_year = document.getElementById("dat_to_year")
    
    if(val == "all years") {
        dat_to_year.value = "all years"
    } else if(parseInt(val) > parseInt(dat_to_year.value) || dat_to_year.value == "all years") {
        dat_to_year.value = val
    }
}

function changeEventOnTo(val){
    const dat_from_year = document.getElementById("dat_from_year")
    
    if(val == "all years") {
        dat_from_year.value = "all years"
    } else if(parseInt(val) > parseInt(dat_from_year.value) || dat_from_year.value == "all years") {
        dat_from_year.value = val
    } 
}

async function loadCatalougeData(){
    try {
        const response = await fetch('/catalogues');
        if (!response.ok) {
            throw new Error('Network response was not ok');
        }

        const data = await response.json();

        // Build the HTML content dynamically
        const contentDiv = document.getElementById('catalogues-content');

        
       let cataloguesHTML = `
            <div id="news-output" class="panel">
                <div class="row">
                    <h2 style="margin-left: 15px;">Featured Catalogues</h2>
        `;

        // Loop through the data and add content for each item
        data.forEach((item , index) => {
            let img = ""

            if(item.acf && item.acf.catalogue_main_image && item.acf.catalogue_main_image.length > 0) {
                img = item.acf.catalogue_main_image[0].catalogue_images
            } else {
                img = "/static/img/news/KMS3059_crop_2.jpg"
            }   

            cataloguesHTML += `
                <div class="item large-4 medium-4 small-12 columns">
                    <a class="link" href="${item.link}">
                        <div class="image">
                            <img src="${img}" alt="Catalog blog image${index+1}" />
                        </div>
                        <h3 class="title">${item.title}</h3>
                    </a>
                </div>
            `;
        });

        cataloguesHTML += `</div></div>`;

        // Insert the final HTML into the contentDiv
        contentDiv.innerHTML = cataloguesHTML;
    } catch (error) {
        console.error('Error fetching data:', error);
    }
}

window.onload = loadCatalougeData();
</script>
{% endblock extra_js_bottom %}
