{% extends "base.jinja2" %}

{% block title %}Profile{% endblock %}
{% block extra_stylesheets %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/chart.css') }}">
<style>
   .content{
    margin-left: 40px;
   }
   .tiny{
        padding-top: 0.625rem;
        padding-right: 1.25rem;
        padding-bottom: 0.6875rem;
        padding-left: 1.25rem;
        font-size: 0.6875rem;
    }
	h3.worklegend{font-size:25px !important;margin-top: 0.5rem;margin-bottom: 0.2rem;}
    .workspacing h4{
        margin-top: 0.5rem;margin-bottom: 0.2rem;
    }
	.profilepart h4{font-size:22px !important}
	.profilepart h5 { font-size: 20px !important; }
	p {
        font-family: "Arvo-sans", sans-serif;
        font-weight: normal;
        font-size: 1rem;
        line-height: 1.6;
        text-rendering: optimizeLegibility;
    }
	.people,.locations {
		margin-bottom: 17px;
		margin-left: 10px;
	}
	.fieldlabel { color:#172854; min-width: 120px; margin-right: 10px;display:inline-block }
	.flags{font-size:smaller}
	.flags:before { content:"("}
	.flags:after { content:")"}
	.profilepart .profilepart .content { margin-left: 6px; }
	.workspacing .display_details_of_one_object.true {
		border-left: 1px dashed #777;
		padding: 5px 0 5px 20px;
		margin-bottom: 10px;
	}
    h3,h4,h5,h6 {
        font-weight: normal;
        font-style: normal;
        text-rendering: optimizeLegibility;
    }
	.comment {
		margin-top: 10px;
	}
    #repo{
        display: none;
    }
    .highlight-box{
        margin-bottom: 20px;
    }
    #work-profile p{
        margin-bottom: 0px;
    }
    .large-9 {
        margin-left: 25px;
        width: 70%;
    }

</style>
{% endblock %}

{% block content %}
    <div id="profile-display" style="min-height: 300px;"></div>
{% endblock %}

{% block extra_js_bottom %}
    <script type="module" src="{{ url_for('static', filename='js/profile.edges.js') }}"></script>
    <script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>
    <script type="text/javascript" src="{{ url_for('static', filename='libs/d3/d3.v3.min.js') }}"></script>

    <script type="module">
        import { searchQueryObj } from "{{ url_for('static', filename='js/search.js') }}";
        import { modifyCurrentSearch } from "{{ url_for('static', filename='js/helper/modifyCurrentSearch.js') }}";
        import { buildSolrQuery } from "{{ url_for('static', filename='js/helper/buildSolrQuery.js') }}";

       document.addEventListener('DOMContentLoaded', function() {
        try {
            const urlParams = new URLSearchParams(window.location.search);
            const uuid = urlParams.get('uuid');
            const type = urlParams.get('type');
            const startRaw = urlParams.get('start');
            const numFoundRaw = urlParams.get('numFound');
            const start = startRaw !== null ? parseInt(startRaw, 10) : NaN;
            const numFound = numFoundRaw !== null ? parseInt(numFoundRaw, 10) : NaN;
            const sort = urlParams.get('sort');
            const letter = urlParams.get('letter');
            const browsing = urlParams.get('browsing');
            const uuids = urlParams.get('uuids');
            const filters = urlParams.get('filters');

            const modDoc = document.getElementById("modify-search");
            const controlDoc = document.getElementById("control");
            const backResultDoc = document.getElementById("back-to-results");
            const backBrowseDoc = document.getElementById("back-to-browse");

            let queryObj = {};
            try {
                queryObj = searchQueryObj() || {};
            } catch (e) {
                console.warn("searchQueryObj() failed:", e);
            }

            console.log("queryObj", queryObj);

            let query = '';
            try {
                query = buildSolrQuery(queryObj.openingQuery) || '';
            } catch (e) {
                console.warn("buildSolrQuery() failed:", e);
            }

            if (!isNaN(start)) {
                try {
                    let apiUrl = '/results?';
                    let qAndOp = "{!q.op=AND} ";

                    if (queryObj.collection && queryObj.collection === "/solr/all/select") {
                        qAndOp = "";
                    }

                    if (query) apiUrl += `q=${qAndOp}${query}&`;
                    if (uuid) apiUrl += `uuid=${uuid}&`;
                    if (type) apiUrl += `type=${type}&`;
                    if (!isNaN(start)) apiUrl += `start=${start}&`;
                    if (!isNaN(numFound)) apiUrl += `numFound=${numFound}&`;
                    if (sort) apiUrl += `sort=${sort}&`;
                    if (uuids) apiUrl += `uuids=${uuids}&`;

                    apiUrl = apiUrl.endsWith('&') ? apiUrl.slice(0, -1) : apiUrl;

                    fetch(apiUrl)
                        .then(response => {
                            if (!response.ok) throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                            return response.json();
                        })
                        .then(data => {
                            try {
                                if (!data || typeof data !== 'object') {
                                    console.warn("Unexpected API response shape:", data);
                                    return;
                                }

                                const { first_entry, prev_entry, next_entry, last_entry } = data;

                                const prevBtn  = document.getElementById('prev-entry');
                                const nextBtn  = document.getElementById('next-entry');
                                const firstBtn = document.getElementById('first-entry');
                                const lastBtn  = document.getElementById('last-entry');
                                const navEl    = document.getElementById('navigation-buttons');
                                const countEl  = document.getElementById('count-heading');

                                // Disable nav buttons based on API response
                                if (prevBtn && !prev_entry)  prevBtn.disabled  = true;
                                if (nextBtn && !next_entry)  nextBtn.disabled  = true;
                                if (firstBtn && start === 0) firstBtn.disabled = true;
                                if (lastBtn  && !isNaN(numFound) && start >= numFound - 1) {
                                    lastBtn.disabled = true;
                                }

                                // Hide nav if start/numFound were absent from the URL
                                if (navEl && (startRaw === null || numFoundRaw === null)) {
                                    navEl.style.display = 'none';
                                }

                                urlParams.delete("start");

                                // Wire navigation buttons only when the entry data exists
                                if (firstBtn && first_entry?.object_type && first_entry?.uuid) {
                                    firstBtn.onclick = () => {
                                        window.location.href = `/profile/${first_entry.object_type}/${first_entry.uuid}?${urlParams}&start=0`;
                                    };
                                }
                                if (prevBtn && prev_entry?.object_type && prev_entry?.uuid && !isNaN(start)) {
                                    prevBtn.onclick = () => {
                                        window.location.href = `/profile/${prev_entry.object_type}/${prev_entry.uuid}?${urlParams}&start=${start - 1}`;
                                    };
                                }
                                if (nextBtn && next_entry?.object_type && next_entry?.uuid && !isNaN(start)) {
                                    nextBtn.onclick = () => {
                                        window.location.href = `/profile/${next_entry.object_type}/${next_entry.uuid}?${urlParams}&start=${start + 1}`;
                                    };
                                }
                                if (lastBtn && last_entry?.object_type && last_entry?.uuid && !isNaN(numFound)) {
                                    lastBtn.onclick = () => {
                                        window.location.href = `/profile/${last_entry.object_type}/${last_entry.uuid}?${urlParams}&start=${numFound - 1}`;
                                    };
                                }

                                // Back to browse
                                if (browsing && backBrowseDoc) {
                                    backBrowseDoc.style.display = "";
                                    backBrowseDoc.onclick = () => {
                                        const browseParams = new URLSearchParams();
                                        if (letter)  browseParams.set('letter', letter);
                                        if (uuids)   browseParams.set('uuids', uuids);
                                        if (filters) browseParams.set('filters', filters);
                                        window.location.href = `/browse/${browsing}?${browseParams}`;
                                    };
                                }

                                // Back to results / modify search
                                if (type) {
                                    if (!browsing && modDoc)    modDoc.style.display    = "inline";
                                    if (backResultDoc)          backResultDoc.style.display = "inline";
                                    if (controlDoc)             controlDoc.style.display    = "inline";

                                    try {
                                        const params = new URLSearchParams(window.location.search);
                                        params.delete('type');
                                        params.delete('numFound');

                                        const startParam = params.get("start");
                                        const pageNumber = (startParam !== null && !isNaN(parseInt(startParam, 10)))
                                            ? Math.floor(parseInt(startParam, 10) / 50) * 50
                                            : 0;

                                        params.set('start', pageNumber);
                                        const newQuery = params.toString();
                                        const href     = newQuery ? `/forms/advanced?${newQuery}` : '/forms/advanced';

                                        if (backResultDoc) {
                                            backResultDoc.onclick = () => { window.location.href = href; };
                                        }
                                        if (modDoc) {
                                            modDoc.onclick = () => {
                                                try {
                                                    modifyCurrentSearch();
                                                } catch (e) {
                                                    console.error("modifyCurrentSearch() failed:", e);
                                                }
                                            };
                                        }
                                    } catch (e) {
                                        console.error("Error building back-to-results URL:", e);
                                    }
                                }

                                // Result count display
                                if (countEl && !isNaN(numFound) && !isNaN(start) && start >= 0) {
                                    countEl.innerHTML = `Result ${start + 1} of ${numFound}`;
                                }

                            } catch (e) {
                                console.error("Error processing navigation API response:", e);
                            }
                        })
                        .catch(err => {
                            console.error("Navigation API fetch failed:", err);
                        });

                } catch (e) {
                    console.error("Error building or dispatching navigation API request:", e);
                }
            }

            // Map initialization
            const checkMapElement = setInterval(function() {
                try {
                    const mapElement = document.getElementById('location-map');

                    if (!mapElement) return; // still waiting

                    clearInterval(checkMapElement);

                    const lat  = parseFloat(mapElement.getAttribute("data-lat"));
                    const long = parseFloat(mapElement.getAttribute("data-long"));

                    if (isNaN(lat) || isNaN(long)) {
                        console.warn("Invalid map coordinates — data-lat or data-long missing/non-numeric.");
                        return;
                    }

                    if (typeof L === 'undefined') {
                        console.error("Leaflet (L) is not loaded — cannot initialize map.");
                        return;
                    }

                    const map = L.map('location-map').setView([lat, long], 8);

                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                    }).addTo(map);

                    L.marker([lat, long])
                        .addTo(map)
                        .bindPopup(`Location: ${lat}, ${long}`)
                        .openPopup();

                } catch (e) {
                    clearInterval(checkMapElement);
                    console.error("Map initialization failed:", e);
                }
            }, 100);

        } catch (e) {
            console.error("Critical error during DOMContentLoaded setup:", e);
        }
    });
    </script>

{% endblock extra_js_bottom %}
