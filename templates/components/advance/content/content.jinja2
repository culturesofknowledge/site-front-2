<fieldset>
    <legend>Content</legend>

    <div
      data-delay="2.0"
      data-tip="Search across abstracts, keywords, incipits, explicits, transcriptions, and enclosures, e.g. 'Spider' or 'Mathematics'.
      <br/> Full-text transcriptions are available currently only for certain catalogues." 
      class="row">
      <div class="small-10 columns">
        <label for="let_con">Search content</label>
        <input
          id="let_con"
          name="let_con"
          type="text"
          class="text"
          value="{{ let_con if let_con else 'all content' }}" 
          data-default="all content"
          onfocus="textClear(this);"
          onblur="textFill(this);"
        />
      </div>
      <div>
        {% include 'components/common/help_icon.jinja2' %}
      </div>
    </div>

    <div
      data-delay="2.0" 
      data-tip="Confine your search to a particular document type."
      class="row">
      <div class="small-10 columns">
        <label for="let_type">Document type</label>
        <select id="let_type" name="let_type" title="" class="">
          <option class="default" selected="selected">all types</option>
          {% for document_type in document_types %}
          <option value="{{ document_type }}"> {{ document_type }} </option>
          {% endfor %}
        </select>
      </div>
      <div>
        {% include 'components/common/help_icon.jinja2' %}
      </div>
    </div>

    <div
      data-delay="2.0"
      data-tip="Confine your search to letters in a particular language." 
      class="row">
      <div class="small-10 columns">
        <label for="let_lang">Language</label>
        <select
          id="let_lang"
          name="let_lang"
          title=""
          class="select2-hidden-accessible"
          tabindex="-1"
          aria-hidden="true"
        >
          <option class="default" selected="selected">all languages</option>
          {% for language in languages %}
          <option value="{{ language }}">{{ language }}</option>
          {% endfor %}
        </select>
      </div>
      <div>
        {% include 'components/common/help_icon.jinja2' %}
      </div>
    </div>

    <div
      data-delay="2.0"
      data-tip="Confine your search to letters for which we have incipits." 
      class="row">
      <div class="columns small-12 large-4">
        <label>In</label>
        <div class="row">
          <div class="small-9 columns">
            <input
              type="checkbox"
              id="incipits"
              name="incipits"
              value="false"
              onchange="changeCheckboxValue(this)"
              class="checkbox"
            />

            <label for="incipitss">Incipits</label>
          </div>
          <div>
            {% include 'components/common/help_icon_nolabel.jinja2' %}
          </div>
        </div>
      </div>

      <div
        data-delay="2.0"
        data-tip="Confine your search to letters for which we have abstracts."  
        class="columns small-12 large-4">
        <label>In</label>
        <div class="row">
          <div class="small-9 columns">
            <input
              type="checkbox"
              id="abstracts"
              name="abstracts"
              value="false"
              onchange="changeCheckboxValue(this)"
            />

            <label for="abstracts">Abstracts</label>
          </div>
          <div>
            {% include 'components/common/help_icon_nolabel.jinja2' %}
          </div>
        </div>
      </div>

      <div 
        data-delay="2.0"
        data-tip="Confine your search to letters for which we have full-text transcriptions."
        class="columns small-12 large-4">
        <label>In</label>
        <div class="row">
          <div class="small-9 columns">
            <input
              type="checkbox"
              id="transcriptions"
              name="transcriptions"
              value="false"
              onchange="changeCheckboxValue(this)"
              class="checkbox"
            />

            <label for="transcriptions">Transcriptions or Translations</label>
          </div>
          <div>
            {% include 'components/common/help_icon_nolabel.jinja2' %}
          </div>
        </div>
      </div>
    </div>
  </fieldset>