{% extends "/base/browse_base.jinja2" %}

{% block browse_content %}
    <div class="row row-with-side">
      <div id="side-nav" class="side-nav" style="display: none;"> 
        <h2 class="main">Current Selection</h2>

        <div id="selected-items-list"></div>

        <div>
            <button onclick="searchLetters('organisations')">Show letters</button>
        </div>
      </div>

      <div class="row row-with-side" style="margin-left: 20px;">

        <div class="large-12 columns">
            <div id="organisations" class="large-12 columns">
                <br/>
                <h2 class="main">
                    <span id="result-header" class="font-18">
                        Organizations
                    </span>

                    <br><br>
                </h2>
            </div>
   
             <div id="" class="large-12 columns">
                <div class="pagination-centered">
                    {% include '/components/common/alphabet_pagination.jinja2' %}
                </div>
                
                <div data-alert="" class="alert-box info radius">
				 
				 You can select up to 10 organisations using the checkboxes below, and then display associated letters.
		                To save your selection for later use, bookmark this page.
				  
				  <a href="#" class="close">×</a>
				</div>
				

                <div class="row">
                    <div id="browse-organisations-results"></div>
                </div>
            </div>
        </div>
      </div>
    </div>
{% endblock %}


{% block extra_js_bottom %}

{% include "_edges_common_js.jinja2" %}
<script type="module" src="../static/js/organisation.edges.js"></script>
{% endblock extra_js_bottom %} 