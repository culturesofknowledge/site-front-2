{% extends "/base/browse_base.jinja2" %}

{% block browse_content %}
    <div class="row row-with-side" style="margin-left: 20px;">
         <div class="large-12 columns">
            <div id="people" class="large-12 columns">
                <br/>
                <h2 class="main">
                    <span class="font-18">
                        Repository
                    </span>

                    <br><br>
                </h2>
            </div>
            <br/>

            <div id="" class="large-12 columns">
                <div class="pagination-centered">
                    {% include '/components/common/alphabet_pagination.jinja2' %}
                </div>

                <div data-alert="" class="alert-box info radius">
				 
				 Note: every manifestation of a letter is counted, so the number of documents 
                 in a repository may be larger than the number of letters.
				  <a href="#" class="close">×</a>
				</div>

                <div class="row">
                    <div id="browse-institution-results"></div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}


{% block extra_js_bottom %}

{% include "_edges_common_js.jinja2" %}
<script type="module" src="../static/js/institution.edges.js"></script>
{% endblock extra_js_bottom %} 